# Copy to .env and adjust. Real environment variables always win over this file.
#
# Bind address. 127.0.0.1 keeps the server reachable only from this machine.
# Setting a LAN address or 0.0.0.0 exposes an agent that can read and write files
# on the paired machine, so only do it on a network you trust.
HOST=127.0.0.1

# Port for both HTTP and WebSocket.
PORT=3000

# SQLite location. In Docker this points at the mounted volume.
DATABASE_FILE=data/tunnelcode.sqlite

# fatal, error, warn, info, debug, trace, or silent.
LOG_LEVEL=info

# Whose forwarded client address to believe. Unset means nobody's, which is the
# only safe answer when the server can be reached directly: X-Forwarded-For is
# then just a header the client writes, and the pairing rate limit stops counting.
# Set true behind a reverse proxy, or name the proxy addresses to trust.
# TRUST_PROXY=true
