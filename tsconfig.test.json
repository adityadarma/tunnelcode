{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    // Tests import the built output, since Node's type stripping does not rewrite
    // the .js specifiers the sources use.
    "allowImportingTsExtensions": true
  },
  "include": ["**/*.ts"]
}
