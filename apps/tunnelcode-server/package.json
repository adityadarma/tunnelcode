{
  "name": "tunnelcode-server",
  "version": "0.3.8",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p web/tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "db:generate": "drizzle-kit generate",
    "build:server": "tsc -b",
    "build:web": "vite build",
    "dev:web": "vite",
    "test": "node --test \"test/**/*.test.ts\" && vitest run",
    "test:server": "node --test \"test/**/*.test.ts\"",
    "test:web": "vitest run"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "10.1.2",
    "@fastify/websocket": "11.3.0",
    "@tunnelcode/config": "workspace:*",
    "@tunnelcode/protocol": "workspace:*",
    "@tunnelcode/shared": "workspace:*",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "30.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
